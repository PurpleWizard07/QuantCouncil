# The api image builds with the repo root as its context (see infra/docker-compose.yml),
# so this file trims what gets sent to the Docker daemon.
.git
.venv
venv
**/__pycache__
**/.pytest_cache
**/*.pyc
*.egg-info
node_modules
apps/web/node_modules
apps/web/.next
# Keep the whole `data` dir out (raw/processed datasets, backtest artifacts)
# except nifty50_symbols.json, which data_connectors.universe needs at
# runtime -- excluding contents (data/*) rather than the dir itself is what
# lets the negation below re-include a single file.
data/*
!data/nifty50_symbols.json
docs
.env
