# QuantCouncil environment configuration.
# Copy this file to .env at the repo root.
# These are development credentials only. Never commit a real .env file.

APP_ENV=development

# --- Postgres ---
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant
POSTGRES_DB=quantcouncil
POSTGRES_PORT=5432
# DATABASE_URL is the single source of truth for the API's DB connection.
DATABASE_URL=postgresql+psycopg2://quant:quant@localhost:5432/quantcouncil

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Web ---
# Base URL the dashboard uses for every API call. NEXT_PUBLIC_ vars are
# inlined at BUILD time by Next.js -- changing this requires rebuilding the
# web app. The client falls back to http://localhost:8000 when unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM (optional; used by the AI committee provider, never required for foundation) ---
ANTHROPIC_API_KEY=

# --- AI Committee (Phase 6; all optional -- mock provider needs nothing) ---
# Provider POST /committee/evaluate uses when the request omits "provider".
# One of: mock | auto | anthropic | gemini | openrouter | ollama.
# "mock" is offline/deterministic/keyless -- the default, so the app and
# every test work with zero LLM credentials and zero network access.
# Manual selection of an unconfigured provider fails loudly; it never
# silently falls back to mock. "auto" resolves by priority (anthropic >
# gemini > openrouter > ollama > mock).
QUANTCOUNCIL_AGENT_PROVIDER=mock
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- Persistence (optional) ---
# Root directory for persisted backtest artifacts (one subdir per run holding
# equity_curve.json + trades.json). Leave empty to use the default: data/backtests
BACKTESTS_DIR=
